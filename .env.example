# Easiest: run `neuranova setup`, then connect accounts on the console's Integrations page.
# Or copy to .env and fill in by hand. Never commit .env.
# Lines starting with # are off; the built-in defaults shown there apply.

# --- Claude ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# NEURANOVA_MODEL=claude-opus-5-5

# --- Gmail (leave blank to disable) ---
# GMAIL_CLIENT_SECRET_FILE=secrets/gmail_client_secret.json
# GMAIL_TOKEN_FILE=secrets/gmail_token.json

# --- Outlook / Microsoft 365 (leave blank to disable) ---
OUTLOOK_CLIENT_ID=
# "common" works for both personal (outlook.com) and work accounts
# OUTLOOK_TENANT=common
# OUTLOOK_TOKEN_CACHE=secrets/outlook_token_cache.json

# --- Todoist ---
TODOIST_API_TOKEN=

# --- WhatsApp Cloud API ---
# Where alerts go. Leave off: WhatsApp is used automatically once connected on the Integrations
# page, and the screen (console) until then. Set to console to force printing.
# NOTIFY_CHANNEL=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your personal number that receives alerts, international format without +, e.g. 919876543210
WHATSAPP_RECIPIENT=
# WHATSAPP_TEMPLATE_NAME=neuranova_update
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v22.0
# Webhook (receives your WhatsApp replies: send / edit / skip ...)
# Any long random string; you paste the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app -> App settings -> Basic -> App secret (used to verify messages really come from Meta)
WHATSAPP_APP_SECRET=
WEBHOOK_PORT=8080
# 127.0.0.1 = only reachable through Caddy on the same machine (recommended). Docker sets 0.0.0.0.
WEB_HOST=127.0.0.1

# --- Dashboard & team (leave DASHBOARD_PASSWORD blank to turn it off) ---
# Your login: OWNER_EMAIL + DASHBOARD_PASSWORD. Teammates set their own passwords from invite links.
OWNER_EMAIL=
OWNER_NAME=
DASHBOARD_PASSWORD=
# Random string, 32+ characters. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET=
# Public address used in invite links, e.g. https://agent.yourdomain.com
PUBLIC_URL=
# Only for testing on http://localhost without HTTPS
# DASHBOARD_INSECURE_COOKIE=1

# --- Storage ---
NEURANOVA_DB=data/neuranova.db
NEURANOVA_CONFIG=neuranova.toml
